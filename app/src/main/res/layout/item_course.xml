<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_pink_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvItemCourseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Название дисциплины"
            android:textColor="@color/dark_bg"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemTeacherName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Преподаватель не указан"
            android:textColor="@color/dark_bg"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDeleteCourse"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:background="@drawable/bg_dark_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Удалить"
        android:textAllCaps="false"
        android:textColor="@color/pink_accent"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

