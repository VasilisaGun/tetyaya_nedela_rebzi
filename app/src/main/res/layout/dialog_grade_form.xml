<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/etGradeValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_dark_pill"
        android:gravity="center"
        android:hint="Оценка (от 2 до 5)"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="@color/pink_accent"
        android:textColorHint="@color/pink_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etGradeDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dark_pill"
        android:gravity="center"
        android:hint="Дата (например, 25.11.2026)"
        android:inputType="date"
        android:textColor="@color/pink_accent"
        android:textColorHint="@color/pink_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerWorkType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dark_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <EditText
        android:id="@+id/etGradeComment"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dark_pill"
        android:gravity="center"
        android:hint="Комментарий (необязательно)"
        android:inputType="textCapSentences"
        android:textColor="@color/pink_accent"
        android:textColorHint="@color/pink_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/pink_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn"
            android:text="Сохранить"
            android:textAllCaps="false"
            android:textColor="@color/pink_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
