<?xml version="1.0" encoding="utf-8"?>
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Верхний блок: тёмный квадрат с оценкой слева + Тип и Дата справа -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDialogGradeValue"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_dark_square"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/pink_accent"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDialogGradeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Тип: Контрольная"
                    android:textColor="@color/dark_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDialogGradeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Дата: 25.11.2026"
                    android:textColor="@color/dark_bg"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Комментарий под квадратом -->
        <TextView
            android:id="@+id/tvDialogGradeComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Комментарий: нет"
            android:textColor="@color/dark_bg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Вопрос по центру -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="Что делаем?"
            android:textColor="@color/dark_bg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Ряд из двух кнопок: Редактировать и Удалить -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnActionEdit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_btn"
                android:text="Редактировать"
                android:textAllCaps="false"
                android:textColor="@color/pink_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnActionDelete"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_btn"
                android:text="Удалить"
                android:textAllCaps="false"
                android:textColor="@color/pink_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Нижняя кнопка Отмена по центру -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnActionCancel"
            android:layout_width="140dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_btn"
            android:text="Отмена"
            android:textAllCaps="false"
            android:textColor="@color/pink_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
