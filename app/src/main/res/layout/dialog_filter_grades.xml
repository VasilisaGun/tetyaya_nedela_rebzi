<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:background="@drawable/bg_dialog_card"
android:orientation="vertical"
android:paddingStart="24dp"
android:paddingTop="24dp"
android:paddingEnd="24dp"
android:paddingBottom="20dp">

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginBottom="16dp"
    android:text="Фильтр оценок"
    android:textColor="@color/dark_bg"
    android:textSize="20sp"
    android:textStyle="bold" />

<!-- Выбор типа работы -->
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:text="Тип работы:"
    android:textColor="@color/dark_bg"
    android:textSize="15sp"
    android:textStyle="bold" />

<Spinner
    android:id="@+id/spinnerFilterType"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/bg_dark_pill"
    android:popupBackground="@drawable/bg_avg_outline"
    android:paddingStart="16dp"
    android:paddingEnd="16dp" />

<!-- Выбор даты -->
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:layout_marginBottom="6dp"
    android:text="Дата:"
    android:textColor="@color/dark_bg"
    android:textSize="15sp"
    android:textStyle="bold" />

<EditText
    android:id="@+id/etFilterDate"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/bg_dark_pill"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:hint="Нажмите, чтобы выбрать дату"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:textColor="@color/pink_accent"
    android:textColorHint="#80CE40C2"
    android:textSize="16sp"
    android:textStyle="bold" />

<!-- Кнопки Сбросить и Применить -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="22dp"
    android:gravity="center"
    android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFilterReset"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_btn"
        android:text="Сбросить"
        android:textAllCaps="false"
        android:textColor="@color/pink_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFilterApply"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_dialog_btn"
        android:text="Применить"
        android:textAllCaps="false"
        android:textColor="@color/pink_accent"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>

</LinearLayout>
