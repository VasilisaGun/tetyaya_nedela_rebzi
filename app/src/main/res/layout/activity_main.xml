<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Личный кабинет"
        android:textColor="@color/pink_accent"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCourses"
        style="@style/MenuButtonStyle"
        android:text="Дисциплина" />

    <Button
        android:id="@+id/btnAddGrade"
        style="@style/MenuButtonStyle"
        android:text="Добавление оценки" />

    <Button
        android:id="@+id/btnAddCourse"
        style="@style/MenuButtonStyle"
        android:text="Добавить дисциплину" />

    <Button
        android:id="@+id/btnDynamics"
        style="@style/MenuButtonStyle"
        android:text="Динамика" />

</LinearLayout>
