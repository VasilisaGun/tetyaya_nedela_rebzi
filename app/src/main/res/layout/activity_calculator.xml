<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/dark_bg"
android:orientation="vertical"
android:padding="20dp">

<ImageButton
    android:id="@+id/btnBack"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:contentDescription="Назад"
    android:scaleType="fitCenter"
    android:src="@drawable/arrow_left" />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="24dp"
    android:text="Калькулятор балла"
    android:textColor="@color/pink_accent"
    android:textSize="24sp"
    android:textStyle="bold" />

<!-- Выбор дисциплины -->
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginBottom="8dp"
    android:text="Выберите дисциплину:"
    android:textColor="@color/pink_accent"
    android:textSize="15sp"
    android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerDisciplines"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_pink_rounded"
        android:popupBackground="@drawable/bg_avg_outline"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />


<!-- Карточка текущей статистики -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_avg_outline"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCurrentAvg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Текущий средний балл: —"
        android:textColor="@color/pink_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGradesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Всего оценок: 0"
        android:textColor="@color/pink_accent"
        android:textSize="14sp" />
</LinearLayout>

<!-- Поле желаемого балла -->
<EditText
    android:id="@+id/etTargetAvg"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/bg_pink_rounded"
    android:gravity="center"
    android:hint="Желаемый балл"
    android:inputType="numberDecimal"
    android:maxLength="4"
    android:textColor="@color/dark_bg"
    android:textColorHint="@color/dark_bg_E6"
    android:textStyle="bold" />

<!-- Кнопка расчёта -->
<Button
    android:id="@+id/btnCalculate"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginStart="36dp"
    android:layout_marginEnd="36dp"
    android:layout_marginBottom="24dp"
    android:backgroundTint="@color/pink_accent"
    android:text="Рассчитать"
    android:textAllCaps="false"
    android:textColor="@color/dark_bg"
    android:textSize="16sp"
    android:textStyle="bold" />

<!-- Блок с результатом -->
<TextView
    android:id="@+id/tvCalcResult"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_pink_rounded"
    android:gravity="center"
    android:padding="18dp"
    android:textColor="@color/dark_bg"
    android:textSize="16sp"
    android:textStyle="bold"
    android:visibility="gone" />

</LinearLayout>
